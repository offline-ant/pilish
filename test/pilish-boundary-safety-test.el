;;; pilish-boundary-safety-test.el --- Detached open and boundary failures -*- lexical-binding: t; -*-

(require 'pilish-shared-test)

(ert-deftest pilish-boundary-test-open-new-detached-selects-file-before-start ()
  "Public open passes the selected file to asynchronous managed startup."
  (pilish-test-with-rpc-session (chat input proc commands)
    (let (setup-arguments)
      (with-current-buffer chat (setq pilish--process nil))
      (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
                ((symbol-function 'pilish--find-session) (lambda (&rest _) nil))
                ((symbol-function 'pilish--session-file-cwd-or-error)
                 (lambda (_) default-directory))
                ((symbol-function 'pilish--check-dependencies) #'ignore)
                ((symbol-function 'pilish--show-session-buffers) #'ignore)
                ((symbol-function 'pilish--setup-session)
                 (lambda (&rest arguments) (setq setup-arguments arguments) chat))
                ((symbol-function 'pilish--resume-selected-session)
                 (lambda (&rest _) (ert-fail "Cannot resume a nil asynchronous process"))))
        (should (eq (pilish-open-session-file "/tmp/selected-saved.jsonl") chat)))
      (should (equal (nth 2 setup-arguments)
                     '("--session" "/tmp/selected-saved.jsonl")))
      (should (equal (nth 6 setup-arguments) "/tmp/selected-saved.jsonl")))))

(ert-deftest pilish-boundary-test-open-unready-detached-never-spawns ()
  "An existing detached view must be live before replacement is attempted."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
              ((symbol-function 'pilish--find-session) (lambda (&rest _) chat))
              ((symbol-function 'pilish--session-file-cwd-or-error)
               (lambda (_) default-directory))
              ((symbol-function 'pilish--check-dependencies) #'ignore)
              ((symbol-function 'pilish--show-session-buffers) #'ignore)
              ((symbol-function 'pilish--setup-session)
               (lambda (&rest _) (ert-fail "Unready existing view must not start another agent")))
              ((symbol-function 'pilish--resume-selected-session)
               (lambda (&rest _) (ert-fail "No replacement before readiness"))))
      (should-error (pilish-open-session-file "/tmp/selected-saved.jsonl")
                    :type 'user-error))))

(ert-deftest pilish-boundary-test-open-ready-detached-reuses-current-process ()
  "Public open of a live view replaces through its existing transport."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (pilish-test--stdout proc (pilish-shared-test--snapshot 1 "attach" nil)
                         '(:type "pimux_live" :generation 1))
    (should (pilish--shared-input-ready-p proc))
    (let (resumed)
      (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
                ((symbol-function 'pilish--find-session) (lambda (&rest _) chat))
                ((symbol-function 'pilish--session-file-cwd-or-error)
                 (lambda (_) default-directory))
                ((symbol-function 'pilish--check-dependencies) #'ignore)
                ((symbol-function 'pilish--show-session-buffers) #'ignore)
                ((symbol-function 'pilish--session-transition-ready-p) (lambda (&rest _) t))
                ((symbol-function 'pilish--setup-session)
                 (lambda (&rest _) (ert-fail "Live view must not start another agent")))
                ((symbol-function 'pilish--resume-selected-session)
                 (lambda (&rest arguments) (setq resumed arguments))))
        (should (eq (pilish-open-session-file "/tmp/selected-saved.jsonl") chat)))
      (should (equal resumed (list proc chat "/tmp/selected-saved.jsonl"))))))

(ert-deftest pilish-boundary-test-render-failure-cannot-complete-live ()
  "The real process filter cannot release input after a failed renderer."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (pilish-test--stdout proc (pilish-shared-test--snapshot 1 "attach" nil)
                         '(:type "pimux_live" :generation 1))
    (should (pilish--shared-input-ready-p proc))
    (with-current-buffer input (insert "draft before renderer failure"))
    (cl-letf (((symbol-function 'pilish--display-session-history)
               (lambda (&rest _) (error "Synthetic renderer failure"))))
      (pilish-test--stdout proc (pilish-shared-test--snapshot 2 "request" nil)
                           '(:type "pimux_live" :generation 2)))
    (should-not (pilish--shared-input-ready-p proc))
    (should-not (process-get proc 'pilish-input-context))
    (should-not (process-get proc 'pilish-mux-applied-generation))
    (should (process-get proc 'pilish-mux-awaiting-snapshot))
    (should (equal (plist-get (pilish-session-runtime chat) :state) "unavailable"))
    (should (equal (pilish-session-file chat) "/tmp/s1.jsonl"))
    (with-current-buffer input (should (equal (buffer-string) "")))
    (should (seq-find (lambda (record)
                        (equal (plist-get record :draft) "draft before renderer failure"))
                      (pilish-session-quarantine chat)))
    ;; An explicit newer full resynchronization, not that failed live marker,
    ;; can establish a usable view.  No recovered draft is resent.
    (pilish-test--stdout proc (pilish-shared-test--snapshot 3 "request" nil)
                         '(:type "pimux_live" :generation 3))
    (should (pilish--shared-input-ready-p proc))
    (should (= (process-get proc 'pilish-mux-applied-generation) 3))
    (should (= (length (pilish-session-quarantine chat)) 1))))

(ert-deftest pilish-boundary-test-history-error-retains-new-identity-gates-input ()
  "An identity-only snapshot never keeps the old file or unlocks mutations."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (with-current-buffer chat
      (setq pilish--runtime '(:protocol 2 :mux-id "m1" :pi-pid 42)
            pilish--state '(:session-file "/tmp/previous.jsonl")))
    (let ((snapshot (pilish-shared-test--snapshot
                     2 "session_changed" nil :file "/tmp/new-identity.jsonl")))
      (setq snapshot (plist-put snapshot :historyError "Synthetic oversized history"))
      (pilish-test--stdout proc snapshot '(:type "pimux_live" :generation 2)))
    (should (equal (pilish-session-file chat) "/tmp/new-identity.jsonl"))
    (should (equal (plist-get (pilish-session-runtime chat) :session-file)
                   "/tmp/new-identity.jsonl"))
    (should (= (plist-get (pilish-session-runtime chat) :pi-pid) 42))
    (should-not (pilish--shared-input-ready-p proc))
    (should-not (process-get proc 'pilish-input-context))))

(ert-deftest pilish-boundary-test-missing-context-and-partial-history-refuse ()
  "A plausible file/leaf is not a substitute for the owning context token."
  (dolist (missing '(:inputContext :entries :messages))
    (pilish-test-with-rpc-session (chat input proc commands)
      (process-put proc 'pilish-detached t)
      (pilish-shared-test--hello proc)
      (let ((snapshot (pilish-shared-test--snapshot 1 "attach" nil)))
        (setq snapshot (plist-put snapshot missing :null))
        (pilish-test--stdout proc snapshot '(:type "pimux_live" :generation 1)))
      (should-not (pilish--shared-input-ready-p proc))
      (should-not (process-get proc 'pilish-input-context)))))

(ert-deftest pilish-boundary-test-gap-invalidates-successful-input-context ()
  "An unfinished newer boundary cannot reuse an earlier owning context."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (pilish-test--stdout proc (pilish-shared-test--snapshot 1 "attach" nil)
                         '(:type "pimux_live" :generation 1))
    (should (pilish--shared-input-ready-p proc))
    (pilish-test--stdout proc '(:type "pimux_gap" :generation 2 :dropped 1))
    (should-not (process-get proc 'pilish-input-context))
    (pilish-test--stdout proc '(:type "pimux_live" :generation 2))
    (should-not (pilish--shared-input-ready-p proc))))

(ert-deftest pilish-boundary-test-opaque-context-is-not-manufactured-from-head ()
  "Retain the owning branch anchor exactly, not the snapshot's moving head."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (let* ((context '(:sessionFile "/tmp/s1.jsonl" :leafId :null :contextId "stable-anchor"))
           (snapshot (pilish-shared-test--snapshot 1 "attach" nil)))
      (setq snapshot (plist-put snapshot :inputContext context))
      (pilish-test--stdout proc snapshot '(:type "pimux_live" :generation 1))
      (should (pilish--shared-input-ready-p proc))
      (should (equal (process-get proc 'pilish-input-context) context))
      (should-not (equal (plist-get (process-get proc 'pilish-input-context) :leafId)
                         (plist-get snapshot :leafId))))))

(ert-deftest pilish-boundary-test-runtime-identity-callback-failure-gates-input ()
  "A failed required identity callback cannot bless an otherwise full snapshot."
  (pilish-test-with-rpc-session (chat input proc commands)
    (process-put proc 'pilish-detached t)
    (pilish-shared-test--hello proc)
    (cl-letf (((symbol-function 'pilish--runtime-note-snapshot)
               (lambda (&rest _) (error "Synthetic runtime identity failure"))))
      (pilish-test--stdout proc (pilish-shared-test--snapshot 1 "attach" nil)
                           '(:type "pimux_live" :generation 1)))
    (should-not (pilish--shared-input-ready-p proc))
    (should-not (process-get proc 'pilish-mux-applied-generation))
    (should-not (process-get proc 'pilish-input-context))
    (should (string-match-p "identity failure"
                            (process-get proc 'pilish-mux-application-error)))))

(provide 'pilish-boundary-safety-test)
;;; pilish-boundary-safety-test.el ends here
