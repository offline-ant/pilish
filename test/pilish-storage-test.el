;;; pilish-storage-test.el --- Managed browser storage tests -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;; Deterministic frontend contracts.  Cross-process claims and real managed
;; export are exercised separately by pilish-storage.test.mjs with synthetic
;; roots and explicit compiled runtime inputs.  No production claims are read.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'pilish-storage)
(require 'pilish-browse)

(defvar pilish-runtime-pimux-executable nil)

(ert-deftest pilish-storage-test-unshared-native-policy ()
  (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () nil))
            ((symbol-function 'pilish--browse-append-unshared-session-entry)
             (lambda (&rest args) args))
            ((symbol-function 'pilish-storage-append-entry)
             (lambda (&rest _) (error "Managed helper should not run"))))
    (should (equal (pilish--browse-append-session-entry "/synthetic/file" "label" nil "label")
                   '("/synthetic/file" "label" nil "label")))))

(ert-deftest pilish-storage-test-managed-append-never-falls-back ()
  (let (seen)
    (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
              ((symbol-function 'pilish-storage-append-entry)
               (lambda (&rest args) (setq seen args) (user-error "Foreign owner")))
              ((symbol-function 'pilish--browse-append-unshared-session-entry)
               (lambda (&rest _) (ert-fail "Unsafe append fallback"))))
      (should-error (pilish--browse-append-session-entry "/synthetic/file" "label" '(:targetId "n") "label") :type 'user-error)
      (should (equal seen '("/synthetic/file" "label" (:targetId "n")))))))

(ert-deftest pilish-storage-test-managed-rewrite-needs-source-evidence ()
  (let (seen)
    (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
              ((symbol-function 'pilish-storage-rewrite-session)
               (lambda (&rest args) (setq seen args) (user-error "Runtime owns this file")))
              ((symbol-function 'pilish--browse-rewrite-unshared-session-file)
               (lambda (&rest _) (ert-fail "Unsafe rewrite fallback"))))
      (should-error (pilish--browse-rewrite-session-file "/synthetic/file" ["raw"] "digest") :type 'user-error)
      (should (equal seen '("/synthetic/file" ["raw"] "digest"))))))

(ert-deftest pilish-storage-test-rewrite-serializes-exact-raw-bytes ()
  (let ((bytes (unibyte-string 123 125 13))
        (sha (make-string 64 ?a)) seen)
    (cl-letf (((symbol-function 'pilish-storage-call) (lambda (request) (setq seen request))))
      (pilish-storage-rewrite-session "/synthetic/file" (vector bytes) sha)
      (should (equal (plist-get seen :expectedSha256) sha))
      (should (equal (base64-decode-string (plist-get seen :contents))
                     (concat bytes "\n"))))
    (should-error (pilish-storage-rewrite-session "/synthetic/file" ["bad"] nil) :type 'user-error)))

(ert-deftest pilish-storage-test-delete-retains-confirmed-raw-alias-policy ()
  (let (seen refreshed)
    (with-temp-buffer
      (setq-local pilish--session-browser-items '((:path "/synthetic/alias.jsonl" :canonicalPath "/synthetic/target.jsonl" :firstMessage "Selected")))
      (let ((delete-by-moving-to-trash t))
        (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
                  ((symbol-function 'pilish--session-browser-item-at-point) (lambda () (car pilish--session-browser-items)))
                  ((symbol-function 'pilish--session-browser-path-at-point) (lambda () "/synthetic/alias.jsonl"))
                  ((symbol-function 'pilish--browse-ensure-session-closed) #'ignore)
                  ((symbol-function 'pilish--canonical-session-path) (lambda (&rest _) "/synthetic/target.jsonl"))
                  ((symbol-function 'pilish-storage-delete-session) (lambda (&rest args) (setq seen args)))
                  ((symbol-function 'pilish--session-browser-fetch-and-render) (lambda () (setq refreshed t)))
                  ((symbol-function 'y-or-n-p) (lambda (&rest _) t))
                  ((symbol-function 'delete-file) (lambda (&rest _) (ert-fail "Unleased deletion"))))
          (pilish-session-browser-delete)
          (should (equal seen '("/synthetic/alias.jsonl" t "/synthetic/target.jsonl")))
          (should refreshed))))))

(ert-deftest pilish-storage-test-managed-rename-retains-selected-identity-across-prompt ()
  (let (seen refreshed)
    (with-temp-buffer
      (setq-local pilish--session-browser-items '((:path "/synthetic/alias.jsonl" :canonicalPath "/synthetic/original.jsonl" :name "Original")))
      (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
                ((symbol-function 'pilish--session-browser-path-at-point) (lambda () "/synthetic/alias.jsonl"))
                ((symbol-function 'pilish--get-chat-buffer) (lambda () nil))
                ((symbol-function 'pilish--browse-session-file-matches-p) (lambda (&rest _) nil))
                ((symbol-function 'read-string) (lambda (&rest _) "Selected new name"))
                ((symbol-function 'pilish-storage-append-entry) (lambda (&rest args) (setq seen args)))
                ((symbol-function 'pilish--browse-append-session-info) (lambda (&rest _) (ert-fail "Unleased rename")))
                ((symbol-function 'pilish--session-browser-fetch-and-render) (lambda () (setq refreshed t))))
        (pilish-session-browser-rename)
        (should (equal seen '("/synthetic/alias.jsonl" "session_info" (:name "Selected new name") "/synthetic/original.jsonl")))
        (should refreshed)))))

(ert-deftest pilish-storage-test-trash-json-false-and-export-use-narrow-requests ()
  (let (seen)
    (cl-letf (((symbol-function 'pilish-storage-call) (lambda (request) (setq seen request))))
      (pilish-storage-delete-session "/synthetic/file" nil "/synthetic/file")
      (should (eq (plist-get seen :trash) :json-false))
      (pilish-storage-export-session "/synthetic/file" "/synthetic/output.html" "/release/pi")
      (should (equal seen '(:action "export" :file "/synthetic/file" :output "/synthetic/output.html" :piExecutable "/release/pi"))))))

(ert-deftest pilish-storage-test-refuses-remote-and-unconfigured-calls ()
  (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () nil)))
    (should-error (pilish-storage-call '(:action "delete" :file "/synthetic/file")) :type 'user-error))
  (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t)))
    (let ((pilish-runtime-pimux-executable "/synthetic/pimux"))
      (should-error (pilish-storage-call '(:action "delete" :file "/ssh:foreign:/session.jsonl")) :type 'user-error))))

(ert-deftest pilish-storage-test-helper-receipt-does-not-repeat-an-uncertain-operation ()
  (let ((pilish-runtime-pimux-executable "/synthetic/pimux")
        (calls 0))
    (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
              ((symbol-function 'call-process-region)
               (lambda (&rest _)
                 (cl-incf calls)
                 (erase-buffer)
                 (insert "{\"ok\":false,\"error\":\"committed but release uncertain; do not repeat\"}\n")
                 1)))
      (should-error (pilish-storage-call '(:action "delete" :file "/synthetic/file")) :type 'user-error)
      (should (= calls 1)))))

(ert-deftest pilish-storage-test-incomplete-helper-success-is-not-commitment ()
  (let ((pilish-runtime-pimux-executable "/synthetic/pimux"))
    (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
              ((symbol-function 'call-process-region)
               (lambda (&rest _)
                 (erase-buffer)
                 (insert "{\"ok\":true}\n")
                 0)))
      (should-error (pilish-storage-call '(:action "delete" :file "/synthetic/file")) :type 'user-error))))

(ert-deftest pilish-storage-test-helper-receipt-is-authoritative-json ()
  (let ((pilish-runtime-pimux-executable "/synthetic/pimux"))
    (cl-letf (((symbol-function 'pilish-runtime-configured-p) (lambda () t))
              ((symbol-function 'call-process-region)
               (lambda (&rest _)
                 (erase-buffer)
                 (insert "{\"ok\":true,\"operationId\":\"opaque\",\"committed\":true}\n")
                 0)))
      (let ((receipt (pilish-storage-call '(:action "delete" :file "/synthetic/file"))))
        (should (eq (plist-get receipt :committed) t))
        (should (equal (plist-get receipt :operationId) "opaque"))))))

(provide 'pilish-storage-test)
;;; pilish-storage-test.el ends here
